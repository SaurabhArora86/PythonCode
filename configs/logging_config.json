{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "json_log": {
            "()": "pythonjsonlogger.jsonlogger.JsonFormatter",
            "fmt": "%(asctime)s %(levelname)s %(message)s %(name)s %(module)s %(funcName)s %(lineno)d %(process)d %(thread)d",
            "datefmt": "%Y-%m-%d %H:%M:%S%z"
        }
    },
    "handlers": {
        "stdout": {
            "class": "logging.StreamHandler",
            "formatter": "json_log",
            "stream": "ext://sys.stdout"
        },
        "queue_handler": {
            "class": "logging.handlers.QueueHandler",
            "handlers": [
                "stdout"
            ],
            "respect_handler_level": true
        }
    },
    "loggers": {
        "root": {
            "level": "INFO",
            "handlers": [
                "queue_handler"
            ]
        }
    }
}